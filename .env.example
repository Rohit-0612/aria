# Copy this file to .env and fill in your own keys. Never commit .env.

# ── Credentials ────────────────────────────────────────────────────────
# Groq — LLM inference for every agent
GROQ_API_KEY=your_groq_api_key

# Cohere — cross-encoder reranking
COHERE_API_KEY=your_cohere_api_key

# Qdrant Cloud — hosted vector store (ARIA's evidence base)
# This is a HARD dependency: with no vector store there are no source
# passages, and ARIA fails the consultation rather than answering
# ungrounded. Free-tier clusters are removed after a period of inactivity —
# if that happens, see docs/runbook-evidence-base.md to restore one.
# A local Qdrant (http://localhost:6333) needs no API key.
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# ── Models (all optional) ──────────────────────────────────────────────
# Every value below is the built-in default, shown for reference. Leave them
# unset unless you are overriding one — the deployed Space sets none of them.
# Defined in llm/config.py; validated against the provider on every boot by
# llm/preflight.py.
#
# The larger model writes the answer; the smaller one handles the cheap,
# high-frequency roles (scope check, query rewrite, scoring).

# ARIA_GENERATOR_MODEL=openai/gpt-oss-120b
# ARIA_JUDGE_MODEL=openai/gpt-oss-20b
# ARIA_GUARDRAIL_MODEL=openai/gpt-oss-20b
# ARIA_NAVIGATOR_MODEL=openai/gpt-oss-20b
# ARIA_EVAL_JUDGE_MODEL=openai/gpt-oss-20b

# Used automatically when a primary model returns model_not_found or
# model_decommissioned — the case that took ARIA down when Groq retired
# llama-3.3-70b-versatile.
# ARIA_FALLBACK_MODEL=openai/gpt-oss-20b

# ARIA_RERANK_MODEL=rerank-english-v3.0

# Must match the model the collection was built with — a mismatch does not
# error, it silently returns meaningless neighbours. /api/health reports the
# collection's actual vector size (384 for all-MiniLM-L6-v2) for comparison.
# ARIA_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Vector store (all optional) ────────────────────────────────────────
# ARIA_QDRANT_COLLECTION=aria_medical
# ARIA_QDRANT_TIMEOUT=30

# Minimum Cohere relevance for a passage to be cited. The reranker returns a
# fixed count whether or not that many passages are good, so without a floor
# a thin query pads its citations with material scored 0.0. If nothing clears
# the floor the consultation fails rather than answering ungrounded.
# ARIA_RELEVANCE_FLOOR=0.02

# ── Behaviour ──────────────────────────────────────────────────────────
# Refuse to start when a configured model does not exist upstream. Default
# is off: the startup check logs CRITICAL and /api/health reports
# "degraded", but the app still serves via the fallback model.
# ARIA_PREFLIGHT_STRICT=0

# ARIA_LOG_LEVEL=INFO

# ── Limits on the public endpoint ──────────────────────────────────────
# Every consultation costs four model calls plus a rerank, against Groq's
# 8000 TPM ceiling. The per-client window stops one visitor monopolising the
# app; the concurrency bound protects the TPM cap and cannot be evaded by
# forging a forwarded-for header. Set ARIA_RATE_LIMIT=0 to disable.
# ARIA_RATE_LIMIT=10
# ARIA_RATE_WINDOW_SECONDS=60
# ARIA_MAX_CONCURRENT=4

# Extra browser origins allowed to call the API. The deployed app serves the
# UI and the API from one origin, and the vite dev server proxies /api, so
# both are same-origin and this stays empty. Comma-separated.
# ARIA_CORS_ORIGINS=

# ── Frontend (web/.env.local, dev only) ────────────────────────────────
# VITE_ARIA_MOCK=1 replays built-in sample answers with no backend. It is
# DEV-ONLY by construction and must never be set for a production build:
# the samples are invented clinical content and would be indistinguishable
# from an adjudicated answer.
